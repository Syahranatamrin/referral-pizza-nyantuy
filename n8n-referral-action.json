                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "klaim_free",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "klaim_free"
