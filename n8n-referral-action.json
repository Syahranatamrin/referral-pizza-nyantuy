    {
      "parameters": {
        "jsCode": "let b = $json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nconst row = Number(b.row_number);\nconst n = Number(b.n || 0);\nlet error = '';\nif (!['klaim','tandai_kirim','klaim_free','ping'].includes(b.action)) error = 'action tidak dikenal';\nelse if (b.action !== 'ping' && !(row >= 2)) error = 'row_number tidak valid';\nelse if (b.action === 'klaim_free' && ![1,2,3].includes(n)) error = 'n harus 1-3';\nreturn [{ json: { action: error ? 'error' : b.action, error, kode: String(b.kode || ''), row_number: row, n, catatan: String(b.catatan || '') } }];"
      },
      "name": "Parse Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "parse-request"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "klaim",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "klaim"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "tandai_kirim",
                    "operator": {
