      "parameters": {
        "jsCode": "const req = $('Parse Request').first().json;\nconst row = $input.all().find(i => Number(i.json.row_number) === req.row_number);\nif (!row) return [{ json: { __notfound: true } }];\nif (req.kode && String(row.json['Kode Referral']).trim() !== req.kode.trim()) return [{ json: { __notfound: true, __mismatch: true } }];\nconst qty = (Number(row.json['Qty Klaim Kode']) || 0) + 1;\nreturn [{ json: { row_number: req.row_number, 'Qty Klaim Kode': qty } }];"
      },
